{
  "name": "unixgram-desktop",
  "private": true,
  "version": "1.3.4",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test:e2e": "playwright test settings.spec.ts responsive-settings.spec.ts desktop-runtime.spec.ts settings-palette.spec.ts",
    "test:native-e2e": "npm run tauri:test:windows && playwright test bot-theme-compatibility.spec.ts",
    "preview": "vite preview",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "tauri:build:windows": "scripts\\tauri-build.cmd",
    "tauri:check:windows": "scripts\\tauri-check.cmd",
    "tauri:test:windows": "scripts\\tauri-test.cmd",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "audit:release": "npm run lint && npm run build && npm run test:e2e && npm audit --audit-level=high"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.72.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.65.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "oxlint": "^1.93.0",
    "storybook": "^10.5.10",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
